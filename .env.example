# Copy to .env.local. Any one key is enough; with none, the app runs in Demo Mode.

# Fast tier (roleplay turns, judge). Lowest-latency provider wins.
GROQ_API_KEY=

# Smart tier (dossier, scam design, debrief). First key found wins: Anthropic > OpenAI > Google.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Model IDs (check your provider's docs for current IDs).
# Required when using ANTHROPIC_API_KEY; optional overrides for the other providers.
# SMART_MODEL=
# FAST_MODEL=
